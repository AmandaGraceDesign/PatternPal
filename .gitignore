# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local repro files
/tmp/

# tooling / session state
.claude/
.superpowers/
openspec/
.continue-here.md
/tasks/

# PatternPAL badge source package — not served, not committed
public/tested-in-patternpal.zip

# Clerk user exports
clerk_users.*

# Entitlement sweep output — contains customer emails
scripts/backfill-report.json

# Google Drive upload staging (Drive mirrors ~/Documents and stages tens of
# thousands of files here, which blows past VS Code's git change limit)
.tmp.driveupload/

# Supabase CLI scratch files
supabase/.temp/
